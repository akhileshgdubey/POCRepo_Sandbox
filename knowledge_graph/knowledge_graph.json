{
  "metrics": {
    "best_customers": {
      "business_definition": "Customers generating the highest revenue",
      "metric": "SUM(transaction_amount)",
      "source_table": "sales_transactions",
      "group_by": "customer_id",
      "order_by": "revenue DESC",
      "limit": 10,
      "join_required": true,
      "join_condition": "customers.customer_id = sales_transactions.customer_id"
    }
  },

  "entities": {
    "Customer": {
      "table": "customers",
      "attributes": [
        "customer_id",
        "customer_name",
        "customer_segment",
        "city"
      ]
    },

    "Product": {
      "table": "products",
      "attributes": [
        "product_id",
        "product_name",
        "category"
      ]
    },

    "Region": {
      "table": "regions",
      "attributes": [
        "region_id",
        "region_name",
        "country"
      ]
    },

    "Sales": {
      "table": "sales_transactions",
      "metrics": [
        "revenue",
        "profit",
        "quantity"
      ]
    }
  },

  "relationships": [
    {
      "from": "Customer",
      "relation": "has_transactions",
      "to": "Sales"
    },
    {
      "from": "Product",
      "relation": "generates_sales",
      "to": "Sales"
    },
    {
      "from": "Region",
      "relation": "contains_customer",
      "to": "Customer"
    }
  ],

  "business_terms": {

    "best customers": {
      "definition": "Customers generating the highest revenue",
      "metric": "SUM(revenue)",
      "tables": [
        "customers",
        "sales_transactions"
      ],
      "join_condition": "customers.customer_id = sales_transactions.customer_id"
    },

    "net profit": {
      "definition": "Total revenue minus total cost",
      "metric": "SUM(profit)",
      "table": "sales_transactions",
      "column": "profit"
    },

    "top products": {
      "definition": "Products ranked by revenue contribution",
      "metric": "SUM(revenue)",
      "tables": [
        "products",
        "sales_transactions"
      ],
      "join_condition": "products.product_id = sales_transactions.product_id"
    },

    "monthly revenue": {
      "definition": "Revenue aggregated by month",
      "metric": "SUM(transaction_amount)",
      "table": "sales_transactions",
      "group_by": "transaction_month"
    },

    "sales by region": {
      "definition": "Revenue generated by each region",
      "metric": "SUM(transaction_amount)",
      "tables": [
        "regions",
        "customers",
        "sales_transactions"
      ],
      "join_condition": "regions.region_id = customers.region_id AND customers.customer_id = sales_transactions.customer_id"
    },

    "customer segment": {
      "definition": "Revenue generated by customer segment",
      "metric": "SUM(transaction_amount)",
      "tables": [
        "customers",
        "sales_transactions"
      ],
      "join_condition": "customers.customer_id = sales_transactions.customer_id"
    },

    "product category": {
      "definition": "Revenue generated by product category",
      "metric": "SUM(transaction_amount)",
      "tables": [
        "products",
        "sales_transactions"
      ],
      "join_condition": "products.product_id = sales_transactions.product_id"
    },

    "average transaction value": {
      "definition": "Average amount per transaction",
      "metric": "AVG(transaction_amount)",
      "table": "sales_transactions"
    },

    "top cities": {
      "definition": "Cities generating highest revenue",
      "metric": "SUM(transaction_amount)",
      "tables": [
        "customers",
        "sales_transactions"
      ],
      "join_condition": "customers.customer_id = sales_transactions.customer_id"
    },

    "top selling products": {
      "definition": "Products sold in highest quantity",
      "metric": "SUM(quantity)",
      "tables": [
        "products",
        "sales_transactions"
      ],
      "join_condition": "products.product_id = sales_transactions.product_id"
    },

    "highest profit products": {
      "definition": "Products generating maximum profit",
      "metric": "SUM(profit)",
      "tables": [
        "products",
        "sales_transactions"
      ],
      "join_condition": "products.product_id = sales_transactions.product_id"
    },

    "customer lifetime value": {
      "definition": "Total revenue generated by each customer",
      "metric": "SUM(transaction_amount)",
      "tables": [
        "customers",
        "sales_transactions"
      ],
      "join_condition": "customers.customer_id = sales_transactions.customer_id"
    },

    "revenue trend": {
      "definition": "Revenue over time",
      "metric": "SUM(transaction_amount)",
      "table": "sales_transactions",
      "group_by": "transaction_date"
    }
  }
}